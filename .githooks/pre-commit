#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

echo "==> Spotless"
if ! mvn -q spotless:check; then
    echo "Formatting check failed. Run: make format" >&2
    exit 1
fi

echo "==> Compile"
if ! mvn -q compile; then
    echo "Compile failed." >&2
    exit 1
fi

echo "==> Unit tests"
if ! mvn -q test; then
    echo "Unit tests failed. Run: make test" >&2
    exit 1
fi
